#!/bin/sh

_nginx_normalize_mb() {
    _nginx_name=$1
    _nginx_value=$2

    case "$_nginx_value" in
        ''|*[!0-9]*)
            printf 'frontend nginx: %s must be a positive integer (got "%s")\n' "$_nginx_name" "$_nginx_value" >&2
            return 1
            ;;
    esac

    _nginx_value=$(printf '%s\n' "$_nginx_value" | sed 's/^0*//')
    if [ -z "$_nginx_value" ]; then
        printf 'frontend nginx: %s must be greater than zero\n' "$_nginx_name" >&2
        return 1
    fi

    _nginx_digits=${#_nginx_value}
    if [ "$_nginx_digits" -gt 13 ] || {
        [ "$_nginx_digits" -eq 13 ] && [ "$_nginx_value" -gt 8796093022197 ]
    }; then
        printf 'frontend nginx: %s is too large; the Nginx body limit plus 10 MiB must fit its size type\n' \
            "$_nginx_name" >&2
        return 1
    fi

    printf '%s' "$_nginx_value"
}

_nginx_max_upload_mb=$(_nginx_normalize_mb MAX_UPLOAD_MB "${MAX_UPLOAD_MB-25}") || return 1
_nginx_max_photo_mb=$(_nginx_normalize_mb VISION_MAX_PHOTO_MB "${VISION_MAX_PHOTO_MB-25}") || return 1
_nginx_max_video_mb=$(_nginx_normalize_mb VISION_MAX_VIDEO_MB "${VISION_MAX_VIDEO_MB-1024}") || return 1

if [ "$_nginx_max_upload_mb" -lt 100 ]; then
    _nginx_upload_base_mb=100
else
    _nginx_upload_base_mb=$_nginx_max_upload_mb
fi
NGINX_UPLOAD_BODY_LIMIT=$((_nginx_upload_base_mb + 10))

if [ "$_nginx_max_photo_mb" -gt "$_nginx_max_video_mb" ]; then
    _nginx_vision_base_mb=$_nginx_max_photo_mb
else
    _nginx_vision_base_mb=$_nginx_max_video_mb
fi
NGINX_VISION_BODY_LIMIT=$((_nginx_vision_base_mb + 10))
if [ "$NGINX_VISION_BODY_LIMIT" -lt 1100 ]; then
    NGINX_VISION_BODY_LIMIT=1100
fi

export NGINX_UPLOAD_BODY_LIMIT NGINX_VISION_BODY_LIMIT
unset -f _nginx_normalize_mb
unset _nginx_name _nginx_value _nginx_digits
unset _nginx_max_upload_mb _nginx_max_photo_mb _nginx_max_video_mb
unset _nginx_upload_base_mb _nginx_vision_base_mb
